SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'PCRE2',
      #directory : 'src',
      #load : [ 'PharoTests' ],
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #packages : [ 'PCRE2-PharoBackend-Tests' ],
    #coverage : {
      #packages : [ 'PCRE2', 'PCRE2-PharoBackend' ],
      #format : #lcov
    }
  }
}

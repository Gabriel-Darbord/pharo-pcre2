SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'PCRE2',
      #directory : 'src',
      #load : [ 'All' ],
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #packages : [
      'PCRE2-Tests',
      'PCRE2-Tools-Tests',
      'PCRE2-PharoBackend-Tests',
      'PCRE2-BackendIntegration-Tests'
    ],
    #coverage : {
      #packages : [ 'PCRE2', 'PCRE2-FFIBackend', 'PCRE2-PharoBackend', 'PCRE2-Tools' ],
      #format : #lcov
    }
  }
}

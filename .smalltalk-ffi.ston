SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'PCRE2',
      #directory : 'src',
      #load : [ 'FFI', 'FFITests' ],
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #packages : [ 'PCRE2-Tests' ],
    #coverage : {
      #packages : [
        'PCRE2',
        'PCRE2-Trace',
        'PCRE2-Substitution',
        'PCRE2-DFA',
        'PCRE2-Wide',
        'PCRE2-FFIBackend'
      ],
      #format : #lcov
    }
  }
}

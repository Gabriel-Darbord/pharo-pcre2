"
The Unicode properties Pharo has no table for, pinned at Unicode 17.0.0 with the property names of PCRE2 10.49: scripts and script extensions, bidi classes, binary properties such as Emoji, the grapheme cluster breaks of `\X`, and the script masks of script runs. General categories, case folding and digits come from `PCRE2UnicodeData` tables instead.

Loading this package registers me with `PCRE2UnicodeData`. Without me, a pattern that names one of these properties, or uses `\X` or a script run, fails to compile with `PCRE2UnsupportedFeature`.

`data` keeps the 451 property range lists in `PCRE2PackedProperties`, packed until a pattern names one. A pattern uses a handful, so an image that matches a few patterns carries tens of kilobytes of ranges instead of the half megabyte all of them would take.
"
Class {
	#name : 'PCRE2UnicodeProperties',
	#superclass : 'PCRE2PackedUnicodeData',
	#category : 'PCRE2-UnicodeProperties',
	#package : 'PCRE2-UnicodeProperties'
}

{ #category : 'accessing' }
PCRE2UnicodeProperties class >> alias: name family: family [

	^ (self data at: 'aliases') at: family , ':' , name ifAbsent: [ name ]
]

{ #category : 'decoding' }
PCRE2UnicodeProperties class >> decode: bytes [

	| stream sections |
	stream := ReadStream on: bytes.
	sections := Dictionary new.
	sections at: 'version' put: (self readTextFrom: stream) first.
	sections at: 'properties' put: (self readPropertiesNamed: (self readTextFrom: stream) from: stream in: bytes).
	sections at: 'aliases' put: (self readAliasesFrom: stream).
	sections at: 'allowedProperties' put: (self readAllowedPropertiesFrom: stream).
	sections at: 'scriptMasks' put: (self readTriplesFrom: stream).
	^ sections
]

{ #category : 'generated data' }
PCRE2UnicodeProperties class >> encoded [
	"The packed sections, gzipped, in base64."

	^ ''
]

{ #category : 'graphemes' }
PCRE2UnicodeProperties class >> graphemeEndIn: subject from: position [

	| left right offset epZWJ previous count |
	offset := subject nextOffsetFrom: position.
	left := self graphemeType: (subject at: position + 1) asInteger.
	epZWJ := false.
	[ offset < subject size ] whileTrue: [
			right := self graphemeType: (subject at: offset + 1) asInteger.
			(self joinGrapheme: left with: right) ifFalse: [ ^ offset ].
			(left = 'zwj' and: [ right = 'ep' and: [ epZWJ not ] ]) ifTrue: [ ^ offset ].
			(left = 'regionalindicator' and: [ right = 'regionalindicator' ]) ifTrue: [
					previous := subject previousOffsetFrom: offset.
					count := 0.
					[ previous >= 0 and: [ (self graphemeType: (subject at: previous + 1) asInteger) = 'regionalindicator' ] ] whileTrue: [
							count := count + 1.
							previous := subject previousOffsetFrom: previous ].
					count even ifTrue: [ ^ offset ] ].
			epZWJ := left = 'ep' and: [ right = 'zwj' ].
			(right = 'extend' and: [ left = 'ep' ]) ifFalse: [ left := right ].
			offset := subject nextOffsetFrom: offset ].
	^ offset
]

{ #category : 'graphemes' }
PCRE2UnicodeProperties class >> graphemeType: code [

	#( 'cr' 'lf' 'control' 'extend' 'prepend' 'spacingmark' 'l' 'v' 't' 'lv' 'lvt' 'regionalindicator' 'zwj' ) do: [ :kind |
		(self includes: code in: (self rangesFor: 'gcb:' , kind)) ifTrue: [ ^ kind ] ].
	(self matches: 'bool:extendedpictographic' code: code) ifTrue: [ ^ 'ep' ].
	^ 'other'
]

{ #category : 'accessing' }
PCRE2UnicodeProperties class >> includes: code in: ranges [

	| low high middle first last |
	low := 1.
	high := ranges size // 2.
	[ low <= high ] whileTrue: [
			middle := low + high // 2.
			first := ranges at: middle * 2 - 1.
			last := ranges at: middle * 2.
			code < first
				ifTrue: [ high := middle - 1 ]
				ifFalse: [
						code > last
							ifTrue: [ low := middle + 1 ]
							ifFalse: [ ^ true ] ] ].
	^ false
]

{ #category : 'class initialization' }
PCRE2UnicodeProperties class >> initialize [

	PCRE2UnicodeData properties: self
]

{ #category : 'properties' }
PCRE2UnicodeProperties class >> isDefaultProperty: key [
	"Answer whether a code point beyond Unicode has this property."

	^ #( 'sc:zzzz' 'scx:zzzz' 'bc:l' ) includes: key
]

{ #category : 'properties' }
PCRE2UnicodeProperties class >> isScriptRun: text from: start to: end [

	| allowed digits |
	end - start < 1 ifTrue: [ ^ true ].
	start to: end do: [ :index |
			| code mask |
			code := (text at: index) asInteger.
			mask := self scriptMaskFor: code.
			allowed := allowed ifNil: [ mask ] ifNotNil: [ allowed bitAnd: mask ].
			allowed = 0 ifTrue: [ ^ false ].
			"Every digit of a run belongs to the same set of ten, named by the code of its zero."
			(PCRE2UnicodeData decimalValueOf: code) ifNotNil: [ :value |
					digits ifNil: [ digits := code - value ].
					digits = (code - value) ifFalse: [ ^ false ] ] ].
	^ true
]

{ #category : 'graphemes' }
PCRE2UnicodeProperties class >> joinGrapheme: left with: right [

	left = 'cr' ifTrue: [ ^ right = 'lf' ].
	(#( 'lf' 'control' ) includes: left) ifTrue: [ ^ false ].
	(#( 'cr' 'lf' 'control' ) includes: right) ifTrue: [ ^ false ].
	left = 'regionalindicator' ifTrue: [ ^ right = 'regionalindicator' ].
	left = 'prepend' ifTrue: [ ^ right ~= 'ep' ].
	(#( 'extend' 'spacingmark' 'zwj' ) includes: right) ifTrue: [ ^ true ].
	left = 'l' ifTrue: [ ^ #( 'l' 'v' 'lv' 'lvt' ) includes: right ].
	(#( 'lv' 'v' ) includes: left) ifTrue: [ ^ #( 'v' 't' ) includes: right ].
	(#( 'lvt' 't' ) includes: left) ifTrue: [ ^ right = 't' ].
	^ left = 'zwj' and: [ right = 'ep' ]
]

{ #category : 'properties' }
PCRE2UnicodeProperties class >> matches: key code: code [

	| ranges |
	code > 16r10FFFF ifTrue: [ ^ self isDefaultProperty: key ].
	ranges := self rangesFor: key.
	ranges ifNil: [ PCRE2UnsupportedFeature signal: 'Unicode property ' , key ].
	^ self includes: code in: ranges
]

{ #category : 'properties' }
PCRE2UnicodeProperties class >> predicateFor: property [
	"Answer a predicate on characters for a property that is not a general category: a script, script extension, bidi class or binary property, named alone or after its family such as sc= or bc:."

	| normalized catalog delimiter prefix value key ranges |
	normalized := PCRE2UnicodeData normalize: property.
	catalog := self data at: 'allowedProperties'.
	((normalized includes: $=) or: [ normalized includes: $: ])
		ifTrue: [
				delimiter := (normalized includes: $=)
					             ifTrue: [ $= ]
					             ifFalse: [ $: ].
				prefix := normalized copyUpTo: delimiter.
				value := normalized copyAfter: delimiter.
				(#( 'bc' 'bidiclass' ) includes: prefix) ifTrue: [ ^ self predicateFor: 'bidi' , value ].
				(catalog includesKey: value) ifFalse: [ self unknownProperty: property ].
				(#( 'sc' 'script' ) includes: prefix) ifTrue: [ key := 'sc:' , (self alias: value family: 'sc') ].
				(#( 'scx' 'scriptextensions' ) includes: prefix) ifTrue: [ key := 'scx:' , (self alias: value family: 'sc') ] ]
		ifFalse: [
				(catalog includesKey: normalized) ifFalse: [ self unknownProperty: property ].
				(normalized beginsWith: 'bidi') ifTrue: [
						value := normalized allButFirst: 4.
						(self rangesFor: 'bc:' , value) ifNotNil: [ key := 'bc:' , value ] ].
				key ifNil: [
						value := self alias: normalized family: 'sc'.
						(self rangesFor: 'scx:' , value) ifNotNil: [ key := 'scx:' , value ] ].
				key ifNil: [
						value := self alias: normalized family: 'bool'.
						(self rangesFor: 'bool:' , value) ifNotNil: [ key := 'bool:' , value ] ] ].
	key ifNil: [ self unknownProperty: property ].
	(#( 'scx:zyyy' 'scx:zinh' 'scx:zzzz' ) includes: key) ifTrue: [ key := 'sc:' , (key copyAfter: $:) ].
	ranges := (self rangesFor: key) ifNil: [ self unknownProperty: property ].
	^ [ :character |
		  character asInteger > 16r10FFFF
			  ifTrue: [ self isDefaultProperty: key ]
			  ifFalse: [ self includes: character asInteger in: ranges ] ]
]

{ #category : 'accessing' }
PCRE2UnicodeProperties class >> rangesFor: key [

	^ (self data at: 'properties') at: key ifAbsent: [ nil ]
]

{ #category : 'decoding' }
PCRE2UnicodeProperties class >> readAliasesFrom: stream [

	| aliases |
	aliases := Dictionary new.
	(self readTextFrom: stream) do: [ :line | aliases at: (line copyUpTo: $=) put: (line copyAfter: $=) ].
	^ aliases
]

{ #category : 'decoding' }
PCRE2UnicodeProperties class >> readAllowedPropertiesFrom: stream [

	| allowed |
	allowed := Dictionary new.
	(self readTextFrom: stream) do: [ :property | allowed at: property put: true ].
	^ allowed
]

{ #category : 'decoding' }
PCRE2UnicodeProperties class >> readPropertiesNamed: names from: stream in: bytes [
	"Note where each property starts and step over it, so only the properties a pattern uses are ever unpacked."

	| offsets start |
	offsets := Dictionary new.
	start := stream position.
	names do: [ :property |
			offsets at: property put: stream position - start.
			self skipRangesFrom: stream ].
	^ PCRE2PackedProperties new bytes: (bytes copyFrom: start + 1 to: stream position) offsets: offsets
]

{ #category : 'properties' }
PCRE2UnicodeProperties class >> scriptMaskFor: code [

	| ranges low high middle |
	ranges := self data at: 'scriptMasks'.
	low := 1.
	high := ranges size // 3.
	[ low <= high ] whileTrue: [
			middle := low + high // 2.
			code < (ranges at: middle * 3 - 2)
				ifTrue: [ high := middle - 1 ]
				ifFalse: [
						code > (ranges at: middle * 3 - 1)
							ifTrue: [ low := middle + 1 ]
							ifFalse: [ ^ ranges at: middle * 3 ] ] ].
	^ 0
]

{ #category : 'properties' }
PCRE2UnicodeProperties class >> unknownProperty: property [

	PCRE2UnsupportedFeature signal: 'Unknown PCRE2 Unicode property ' , property
]

{ #category : 'class initialization' }
PCRE2UnicodeProperties class >> unload [

	PCRE2UnicodeData properties: nil
]

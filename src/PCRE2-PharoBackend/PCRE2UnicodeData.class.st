"
Pinned Unicode 17.0.0 range and simple case-fold data from PCRE2 10.49's Unicode tables. Generated by scripts/generate-unicode-data.py; Unicode data license is in docs/Unicode-LICENSE.txt. No C library is used.
"
Class {
	#name : 'PCRE2UnicodeData',
	#superclass : 'Object',
	#classVars : [
		'Data'
	],
	#category : 'PCRE2-PharoBackend',
	#package : 'PCRE2-PharoBackend'
}

{ #category : 'accessing' }
PCRE2UnicodeData class >> alias: name family: family [

	^ (self data at: 'aliases') at: family , ':' , name ifAbsent: [ name ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> case: character upper: upper unicode: unicode [

	| code category |
	code := character asInteger.
	unicode ifFalse: [
			^ code < 128
				  ifTrue: [
						  upper
							  ifTrue: [ character asUppercase ]
							  ifFalse: [ character asLowercase ] ]
				  ifFalse: [ character ] ].
	category := upper
		            ifTrue: [ 'gc:lu' ]
		            ifFalse: [ 'gc:ll' ].
	(self matches: category code: code) ifTrue: [ ^ character ].
	^ Character value: ((self equivalents: code) detect: [ :other | self matches: category code: other ] ifNone: [ code ])
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> data [

	^ Data ifNil: [
			  Data := STONJSON fromString: (GZipReadStream on:
					           (self encoded1 , self encoded2 , self encoded3 , self encoded4 , self encoded5 , self encoded6 , self encoded7)
						           base64Decoded readStream) contents asString ]
]


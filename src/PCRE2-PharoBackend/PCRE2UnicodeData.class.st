{ #category : 'accessing' }
PCRE2UnicodeData class >> equivalents: code [

	^ (self data at: 'equivalents') at: code asString ifAbsent: [ { code } ]
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> fold: code [

	^ (self data at: 'folds') at: code asString ifAbsent: [ code ]
]

{ #category : 'graphemes' }
PCRE2UnicodeData class >> graphemeEndIn: text from: position [

	| left right index epZWJ previous count |
	index := position + 1.
	left := self graphemeType: (text at: index) asInteger.
	epZWJ := false.
	[ index < text size ] whileTrue: [
			right := self graphemeType: (text at: index + 1) asInteger.
			(self joinGrapheme: left with: right) ifFalse: [ ^ index ].
			(left = 'zwj' and: [ right = 'ep' and: [ epZWJ not ] ]) ifTrue: [ ^ index ].
			(left = 'regionalindicator' and: [ right = 'regionalindicator' ]) ifTrue: [
					previous := index.
					count := 0.
					[ previous > 0 and: [ (self graphemeType: (text at: previous) asInteger) = 'regionalindicator' ] ] whileTrue: [
							count := count + 1.
							previous := previous - 1 ].
					count even ifTrue: [ ^ index ] ].
			epZWJ := left = 'ep' and: [ right = 'zwj' ].
			(right = 'extend' and: [ left = 'ep' ]) ifFalse: [ left := right ].
			index := index + 1 ].
	^ index
]

{ #category : 'graphemes' }
PCRE2UnicodeData class >> graphemeType: code [

	#( 'cr' 'lf' 'control' 'extend' 'prepend' 'spacingmark' 'l' 'v' 't' 'lv' 'lvt' 'regionalindicator' 'zwj' ) do: [ :kind |
		(self includes: code in: (self rangesFor: 'gcb:' , kind)) ifTrue: [ ^ kind ] ].
	(self matches: 'bool:extendedpictographic' code: code) ifTrue: [ ^ 'ep' ].
	^ 'other'
]

{ #category : 'properties' }
PCRE2UnicodeData class >> inRange: code from: low to: high unicode: unicode [

	(code between: low and: high) ifTrue: [ ^ true ].
	unicode ifTrue: [ ^ (self equivalents: code) anySatisfy: [ :other | other between: low and: high ] ].
	(code between: 65 and: 90) ifTrue: [ ^ code + 32 between: low and: high ].
	(code between: 97 and: 122) ifTrue: [ ^ code - 32 between: low and: high ].
	^ false
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> includes: code in: ranges [

	| low high middle first last |
	low := 1.
	high := ranges size // 2.
	[ low <= high ] whileTrue: [
			middle := low + high // 2.
			first := ranges at: middle * 2 - 1.
			last := ranges at: middle * 2.
			code < first
				ifTrue: [ high := middle - 1 ]
				ifFalse: [
						code > last
							ifTrue: [ low := middle + 1 ]
							ifFalse: [ ^ true ] ] ].
	^ false
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isGraph: code [

	(self matches: 'gc:z' code: code) ifTrue: [ ^ false ].
	(self matches: 'gc:c' code: code) ifFalse: [ ^ true ].
	^ (self matches: 'gc:cf' code: code) and: [
		  code ~= 16r061C and: [ code ~= 16r180E and: [ (code between: 16r2066 and: 16r2069) not ] ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isPrint: code [

	((self matches: 'gc:zl' code: code) or: [ self matches: 'gc:zp' code: code ]) ifTrue: [ ^ false ].
	(self matches: 'gc:c' code: code) ifFalse: [ ^ true ].
	^ (self matches: 'gc:cf' code: code) and: [ code ~= 16r061C and: [ (code between: 16r2066 and: 16r2069) not ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isScriptRun: text from: start to: end [

	| allowed digits |
	end - start < 1 ifTrue: [ ^ true ].
	start to: end do: [ :index |
			| code mask digitSet |
			code := (text at: index) asInteger.
			mask := self scriptMaskFor: code.
			allowed := allowed ifNil: [ mask ] ifNotNil: [ allowed bitAnd: mask ].
			allowed = 0 ifTrue: [ ^ false ].
			digitSet := (self data at: 'digitSets') at: code asString ifAbsent: [ nil ].
			digitSet ifNotNil: [
					digits ifNil: [ digits := digitSet ].
					digits = digitSet ifFalse: [ ^ false ] ] ].
	^ true
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isSpace: code [

	^ (code between: 9 and: 13) or: [ code = 133 or: [ self matches: 'gc:z' code: code ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isWord: code [

	^ (self matches: 'gc:l' code: code) or: [
		  (self matches: 'gc:n' code: code) or: [ (self matches: 'gc:mn' code: code) or: [ self matches: 'gc:pc' code: code ] ] ]
]

{ #category : 'graphemes' }
PCRE2UnicodeData class >> joinGrapheme: left with: right [

	left = 'cr' ifTrue: [ ^ right = 'lf' ].
	(#( 'lf' 'control' ) includes: left) ifTrue: [ ^ false ].
	(#( 'cr' 'lf' 'control' ) includes: right) ifTrue: [ ^ false ].
	left = 'regionalindicator' ifTrue: [ ^ right = 'regionalindicator' ].
	left = 'prepend' ifTrue: [ ^ right ~= 'ep' ].
	(#( 'extend' 'spacingmark' 'zwj' ) includes: right) ifTrue: [ ^ true ].
	left = 'l' ifTrue: [ ^ #( 'l' 'v' 'lv' 'lvt' ) includes: right ].
	(#( 'lv' 'v' ) includes: left) ifTrue: [ ^ #( 'v' 't' ) includes: right ].
	(#( 'lvt' 't' ) includes: left) ifTrue: [ ^ right = 't' ].
	^ left = 'zwj' and: [ right = 'ep' ]
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> matches: name code: code [

	| ranges |
	ranges := self rangesFor: name.
	ranges ifNil: [ PCRE2UnsupportedFeature signal: 'Unicode property ' , name ].
	^ self includes: code in: ranges
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> normalize: text [

	^ (text reject: [ :character | character isSeparator or: [ '_-' includes: character ] ]) asLowercase
]

{ #category : 'properties' }
PCRE2UnicodeData class >> posixPredicate: property unicode: unicode caseless: caseless [

	| normalized |
	normalized := self normalize: property.
	(normalized beginsWith: '^') ifTrue: [
		^ [ :character | ((self posixPredicate: normalized allButFirst unicode: unicode caseless: caseless) value: character) not ] ].
	unicode ifTrue: [ ^ self unicodePosixPredicate: normalized caseless: caseless ].
	normalized = 'ascii' ifTrue: [ ^ [ :character | character asInteger < 128 ] ].
	normalized = 'graph' ifTrue: [ ^ [ :character | character asInteger between: 33 and: 126 ] ].
	normalized = 'print' ifTrue: [ ^ [ :character | character asInteger between: 32 and: 126 ] ].
	normalized = 'blank' ifTrue: [ ^ [ :character | #( 9 32 ) includes: character asInteger ] ].
	normalized = 'cntrl' ifTrue: [ ^ [ :character | character asInteger < 32 or: [ character asInteger = 127 ] ] ].
	normalized = 'space' ifTrue: [ ^ [ :character | #( 9 10 11 12 13 32 ) includes: character asInteger ] ].
	normalized = 'digit' ifTrue: [ ^ [ :character | character between: $0 and: $9 ] ].
	normalized = 'xdigit' ifTrue: [
		^ [ :character | (character between: $0 and: $9) or: [ (character between: $a and: $f) or: [ character between: $A and: $F ] ] ] ].
	^ [ :character | character asInteger < 128 and: [ (self unicodePosixPredicate: normalized caseless: caseless) value: character ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> predicateFor: property caseless: caseless [

	| normalized prefix value key ranges delimiter |
	normalized := self normalize: property.
	normalized = 'l&' ifTrue: [ normalized := 'lc' ].
	(normalized beginsWith: '^') ifTrue: [
			ranges := self predicateFor: normalized allButFirst caseless: caseless.
			^ [ :character | (ranges value: character) not ] ].
	(#( 'graph' 'print' 'punct' ) includes: normalized) ifTrue: [ ^ self unicodePosixPredicate: normalized caseless: caseless ].
	normalized = 'any' ifTrue: [ ^ [ :character | true ] ].
	normalized = 'ascii' ifTrue: [ ^ [ :character | character asInteger < 128 ] ].
	normalized = 'xan' ifTrue: [
		^ [ :character | (self matches: 'gc:l' code: character asInteger) or: [ self matches: 'gc:n' code: character asInteger ] ] ].
	normalized = 'xwd' ifTrue: [ ^ [ :character | self isWord: character asInteger ] ].
	(#( 'xps' 'xsp' ) includes: normalized) ifTrue: [ ^ [ :character | self isSpace: character asInteger ] ].
	((normalized includes: $=) or: [ normalized includes: $: ])
		ifTrue: [
				delimiter := (normalized includes: $=)
					             ifTrue: [ $= ]
					             ifFalse: [ $: ].
				prefix := normalized copyUpTo: delimiter.
				value := normalized copyAfter: delimiter.
				(#( 'sc' 'script' ) includes: prefix) ifTrue: [ key := 'sc:' , (self alias: value family: 'sc') ].
				(#( 'scx' 'scriptextensions' ) includes: prefix) ifTrue: [ key := 'scx:' , (self alias: value family: 'sc') ].
				(#( 'bc' 'bidiclass' ) includes: prefix) ifTrue: [ key := 'bc:' , (self alias: value family: 'bc') ].
				(#( 'gc' 'generalcategory' ) includes: prefix) ifTrue: [ key := 'gc:' , (self alias: value family: 'gc') ] ]
		ifFalse: [
				value := self alias: normalized family: 'gc'.
				(self rangesFor: 'gc:' , value) ifNotNil: [ key := 'gc:' , value ].
				key ifNil: [
						value := self alias: normalized family: 'sc'.
						(self rangesFor: 'scx:' , value) ifNotNil: [ key := 'scx:' , value ] ].
				key ifNil: [
						value := self alias: normalized family: 'bool'.
						(self rangesFor: 'bool:' , value) ifNotNil: [ key := 'bool:' , value ] ] ].
	key ifNil: [ PCRE2UnsupportedFeature signal: 'Unicode property ' , property ].
	(caseless and: [ #( 'gc:lu' 'gc:ll' 'gc:lt' ) includes: key ]) ifTrue: [ key := 'gc:lc' ].
	ranges := self rangesFor: key.
	ranges ifNil: [ PCRE2UnsupportedFeature signal: 'Unicode property ' , property ].
	^ [ :character | self includes: character asInteger in: ranges ]
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> rangesFor: key [

	^ (self data at: 'properties') at: key ifAbsent: [ nil ]
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> reset [

	Data := nil
]

{ #category : 'properties' }
PCRE2UnicodeData class >> same: first as: second unicode: unicode [

	unicode ifTrue: [ ^ (self fold: first asInteger) = (self fold: second asInteger) ].
	^ first = second or: [ (first asInteger < 128 and: [ second asInteger < 128 ]) and: [ first asLowercase = second asLowercase ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> scriptMaskFor: code [

	| ranges low high middle |
	ranges := self data at: 'scriptMasks'.
	low := 1.
	high := ranges size // 3.
	[ low <= high ] whileTrue: [
			middle := low + high // 2.
			code < (ranges at: middle * 3 - 2)
				ifTrue: [ high := middle - 1 ]
				ifFalse: [
						code > (ranges at: middle * 3 - 1)
							ifTrue: [ low := middle + 1 ]
							ifFalse: [ ^ ranges at: middle * 3 ] ] ].
	^ 0
]

{ #category : 'properties' }
PCRE2UnicodeData class >> unicodePosixPredicate: property caseless: caseless [

	| key |
	property = 'ascii' ifTrue: [ ^ [ :character | character asInteger < 128 ] ].
	property = 'alnum' ifTrue: [ ^ self predicateFor: 'Xan' caseless: caseless ].
	property = 'word' ifTrue: [ ^ [ :character | self isWord: character asInteger ] ].
	property = 'space' ifTrue: [ ^ [ :character | self isSpace: character asInteger ] ].
	property = 'blank' ifTrue: [ ^ [ :character | character asInteger = 9 or: [ self matches: 'gc:zs' code: character asInteger ] ] ].
	property = 'graph' ifTrue: [ ^ [ :character | self isGraph: character asInteger ] ].
	property = 'print' ifTrue: [ ^ [ :character | self isPrint: character asInteger ] ].
	property = 'punct' ifTrue: [
			^ [ :character |
				  (self matches: 'gc:p' code: character asInteger) or: [
					  character asInteger < 128 and: [ self matches: 'gc:s' code: character asInteger ] ] ] ].
	property = 'xdigit' ifTrue: [
			^ [ :character |
				  | code |
				  code := character asInteger.
				  (code between: 48 and: 57) or: [
						  (code between: 65 and: 70) or: [
								  (code between: 97 and: 102) or: [
									  (code between: 16rFF10 and: 16rFF19) or: [
										  (code between: 16rFF21 and: 16rFF26) or: [ code between: 16rFF41 and: 16rFF46 ] ] ] ] ] ] ].
	key := (Dictionary newFrom: {
			        ('alpha' -> 'L').
			        ('lower' -> 'Ll').
			        ('upper' -> 'Lu').
			        ('digit' -> 'Nd').
			        ('cntrl' -> 'Cc') }) at: property ifAbsent: [ PCRE2UnsupportedFeature signal: 'POSIX class ' , property ].
	^ self predicateFor: key caseless: caseless
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> version [

	^ self data at: 'version'
]

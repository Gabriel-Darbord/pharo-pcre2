"
Pinned Unicode 17.0.0 data and PCRE2 property names from PCRE2 10.49.

`encoded` is the whole catalog as one base64 literal: the sections packed as LEB128 varints, where every table of code points is stored as gaps rather than absolute values, then gzipped. That is about 55 kB of source, against 148 kB for the same data as gzipped JSON, because delta varints give the compressor far less to chew on than decimal digits in brackets.

`data` unpacks it once per session, except for the 489 property range lists, which `PCRE2PackedProperties` leaves packed until a pattern names one. A pattern uses a handful, so an image that matches a few patterns carries tens of kilobytes of ranges instead of the half megabyte all of them would take.

`scripts/generate-unicode-data.py` writes both the JSON and this literal from a pinned PCRE2 checkout, and `decode:` reads the sections in the order the script writes them.

Unicode data uses docs/Unicode-LICENSE.txt; the PCRE2 property catalog uses docs/PCRE2-LICENCE.md.
"
Class {
	#name : 'PCRE2UnicodeData',
	#superclass : 'Object',
	#classVars : [
		'Data'
	],
	#category : 'PCRE2-PharoBackend',
	#package : 'PCRE2-PharoBackend'
}

{ #category : 'accessing' }
PCRE2UnicodeData class >> alias: name family: family [

	^ (self data at: 'aliases') at: family , ':' , name ifAbsent: [ name ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> case: character upper: upper unicode: unicode [

	| code category |
	code := character asInteger.
	unicode ifFalse: [
			^ code < 128
				  ifTrue: [
						  upper
							  ifTrue: [ character asUppercase ]
							  ifFalse: [ character asLowercase ] ]
				  ifFalse: [ character ] ].
	category := upper
		            ifTrue: [ 'gc:lu' ]
		            ifFalse: [ 'gc:ll' ].
	(self matches: category code: code) ifTrue: [ ^ character ].
	^ Character value: ((self equivalents: code) detect: [ :other | self matches: category code: other ] ifNone: [ code ])
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> data [
	"The unpacked pinned Unicode tables, read once and kept for the session."

	^ Data ifNil: [ Data := self decode: (GZipReadStream on: self encoded base64Decoded readStream) contents asByteArray ]
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> decode: bytes [
	"Read the sections scripts/generate-unicode-data.py packs, in the order it writes them."

	| stream data |
	stream := ReadStream on: bytes.
	data := Dictionary new.
	data at: 'version' put: (self readTextFrom: stream) first.
	data at: 'properties' put: (self readPropertiesNamed: (self readTextFrom: stream) from: stream in: bytes).
	data at: 'aliases' put: (self readAliasesFrom: stream).
	data at: 'allowedProperties' put: (self readAllowedPropertiesFrom: stream).
	data at: 'folds' put: (self readCodeTableFrom: stream digitValues: false).
	data at: 'digitSets' put: (self readCodeTableFrom: stream digitValues: true).
	data at: 'equivalents' put: (self readEquivalentsFrom: stream).
	data at: 'scriptMasks' put: (self readScriptMasksFrom: stream).
	^ data
]

{ #category : 'properties' }
PCRE2UnicodeData class >> defaultProperty: key code: code [

	^ #( 'gc:c' 'gc:cn' 'sc:zzzz' 'scx:zzzz' 'bc:l' ) includes: key
]

{ #category : 'generated data' }
PCRE2UnicodeData class >> encoded [
	"The pinned Unicode data of the class comment: the packed sections, gzipped, in base64."

	^ ''
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> equivalents: code [

	^ (self data at: 'equivalents') at: code asString ifAbsent: [ { code } ]
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> fold: code [

	^ (self data at: 'folds') at: code asString ifAbsent: [ code ]
]

{ #category : 'graphemes' }
PCRE2UnicodeData class >> graphemeEndIn: subject from: position [

	| left right offset epZWJ previous count |
	offset := subject nextOffsetFrom: position.
	left := self graphemeType: (subject at: position + 1) asInteger.
	epZWJ := false.
	[ offset < subject size ] whileTrue: [
			right := self graphemeType: (subject at: offset + 1) asInteger.
			(self joinGrapheme: left with: right) ifFalse: [ ^ offset ].
			(left = 'zwj' and: [ right = 'ep' and: [ epZWJ not ] ]) ifTrue: [ ^ offset ].
			(left = 'regionalindicator' and: [ right = 'regionalindicator' ]) ifTrue: [
					previous := subject previousOffsetFrom: offset.
					count := 0.
					[ previous >= 0 and: [ (self graphemeType: (subject at: previous + 1) asInteger) = 'regionalindicator' ] ] whileTrue: [
							count := count + 1.
							previous := subject previousOffsetFrom: previous ].
					count even ifTrue: [ ^ offset ] ].
			epZWJ := left = 'ep' and: [ right = 'zwj' ].
			(right = 'extend' and: [ left = 'ep' ]) ifFalse: [ left := right ].
			offset := subject nextOffsetFrom: offset ].
	^ offset
]

{ #category : 'graphemes' }
PCRE2UnicodeData class >> graphemeType: code [

	#( 'cr' 'lf' 'control' 'extend' 'prepend' 'spacingmark' 'l' 'v' 't' 'lv' 'lvt' 'regionalindicator' 'zwj' ) do: [ :kind |
		(self includes: code in: (self rangesFor: 'gcb:' , kind)) ifTrue: [ ^ kind ] ].
	(self matches: 'bool:extendedpictographic' code: code) ifTrue: [ ^ 'ep' ].
	^ 'other'
]

{ #category : 'properties' }
PCRE2UnicodeData class >> inRange: code from: low to: high unicode: unicode [

	(code between: low and: high) ifTrue: [ ^ true ].
	unicode ifTrue: [ ^ (self equivalents: code) anySatisfy: [ :other | other between: low and: high ] ].
	(code between: 65 and: 90) ifTrue: [ ^ code + 32 between: low and: high ].
	(code between: 97 and: 122) ifTrue: [ ^ code - 32 between: low and: high ].
	^ false
]

{ #category : 'properties' }
PCRE2UnicodeData class >> inRange: code from: low to: high unicode: unicode extraOptions: flags [

	| restricted variants |
	restricted := (flags bitAnd: PCRE2 extraCaselessRestrict) ~= 0.
	(unicode and: [ restricted not and: [ (flags bitAnd: PCRE2 extraTurkishCasing) ~= 0 ] ]) ifTrue: [
			variants := self turkishEquivalents: code.
			variants ifNotNil: [ ^ variants anySatisfy: [ :other | other between: low and: high ] ] ].
	^ self
		  inRange: code
		  from: low
		  to: high
		  unicode: unicode
		  restricted: restricted
]

{ #category : 'properties' }
PCRE2UnicodeData class >> inRange: code from: low to: high unicode: unicode restricted: restricted [

	(restricted and: [ unicode ]) ifFalse: [
			^ self
				  inRange: code
				  from: low
				  to: high
				  unicode: unicode ].
	^ (self equivalents: code) anySatisfy: [ :other | code < 128 = (other < 128) and: [ other between: low and: high ] ]
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> includes: code in: ranges [

	| low high middle first last |
	low := 1.
	high := ranges size // 2.
	[ low <= high ] whileTrue: [
			middle := low + high // 2.
			first := ranges at: middle * 2 - 1.
			last := ranges at: middle * 2.
			code < first
				ifTrue: [ high := middle - 1 ]
				ifFalse: [
						code > last
							ifTrue: [ low := middle + 1 ]
							ifFalse: [ ^ true ] ] ].
	^ false
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isGraph: code [

	(self matches: 'gc:z' code: code) ifTrue: [ ^ false ].
	(self matches: 'gc:c' code: code) ifFalse: [ ^ true ].
	^ (self matches: 'gc:cf' code: code) and: [
		  code ~= 16r061C and: [ code ~= 16r180E and: [ (code between: 16r2066 and: 16r2069) not ] ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isPrint: code [

	((self matches: 'gc:zl' code: code) or: [ self matches: 'gc:zp' code: code ]) ifTrue: [ ^ false ].
	(self matches: 'gc:c' code: code) ifFalse: [ ^ true ].
	^ (self matches: 'gc:cf' code: code) and: [ code ~= 16r061C and: [ (code between: 16r2066 and: 16r2069) not ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isScriptRun: text from: start to: end [

	| allowed digits |
	end - start < 1 ifTrue: [ ^ true ].
	start to: end do: [ :index |
			| code mask digitSet |
			code := (text at: index) asInteger.
			mask := self scriptMaskFor: code.
			allowed := allowed ifNil: [ mask ] ifNotNil: [ allowed bitAnd: mask ].
			allowed = 0 ifTrue: [ ^ false ].
			digitSet := (self data at: 'digitSets') at: code asString ifAbsent: [ nil ].
			digitSet ifNotNil: [
					digits ifNil: [ digits := digitSet ].
					digits = digitSet ifFalse: [ ^ false ] ] ].
	^ true
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isSpace: code [

	^ (code between: 9 and: 13) or: [ code = 133 or: [ self matches: 'gc:z' code: code ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> isWord: code [

	^ (self matches: 'gc:l' code: code) or: [
		  (self matches: 'gc:n' code: code) or: [ (self matches: 'gc:mn' code: code) or: [ self matches: 'gc:pc' code: code ] ] ]
]

{ #category : 'graphemes' }
PCRE2UnicodeData class >> joinGrapheme: left with: right [

	left = 'cr' ifTrue: [ ^ right = 'lf' ].
	(#( 'lf' 'control' ) includes: left) ifTrue: [ ^ false ].
	(#( 'cr' 'lf' 'control' ) includes: right) ifTrue: [ ^ false ].
	left = 'regionalindicator' ifTrue: [ ^ right = 'regionalindicator' ].
	left = 'prepend' ifTrue: [ ^ right ~= 'ep' ].
	(#( 'extend' 'spacingmark' 'zwj' ) includes: right) ifTrue: [ ^ true ].
	left = 'l' ifTrue: [ ^ #( 'l' 'v' 'lv' 'lvt' ) includes: right ].
	(#( 'lv' 'v' ) includes: left) ifTrue: [ ^ #( 'v' 't' ) includes: right ].
	(#( 'lvt' 't' ) includes: left) ifTrue: [ ^ right = 't' ].
	^ left = 'zwj' and: [ right = 'ep' ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> matches: key code: code [

	| ranges |
	code > 16r10FFFF ifTrue: [ ^ self defaultProperty: key code: code ].
	ranges := self rangesFor: key.
	ranges ifNil: [ PCRE2UnsupportedFeature signal: 'Unicode property ' , key ].
	^ self includes: code in: ranges
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> normalize: text [

	^ (text reject: [ :character | character isSeparator or: [ '_-' includes: character ] ]) asLowercase
]

{ #category : 'properties' }
PCRE2UnicodeData class >> posixPredicate: property unicode: unicode caseless: caseless [

	| normalized |
	normalized := self normalize: property.
	(normalized beginsWith: '^') ifTrue: [
		^ [ :character | ((self posixPredicate: normalized allButFirst unicode: unicode caseless: caseless) value: character) not ] ].
	unicode ifTrue: [ ^ self unicodePosixPredicate: normalized caseless: caseless ].
	normalized = 'ascii' ifTrue: [ ^ [ :character | character asInteger < 128 ] ].
	normalized = 'graph' ifTrue: [ ^ [ :character | character asInteger between: 33 and: 126 ] ].
	normalized = 'print' ifTrue: [ ^ [ :character | character asInteger between: 32 and: 126 ] ].
	normalized = 'blank' ifTrue: [ ^ [ :character | #( 9 32 ) includes: character asInteger ] ].
	normalized = 'cntrl' ifTrue: [ ^ [ :character | character asInteger < 32 or: [ character asInteger = 127 ] ] ].
	normalized = 'space' ifTrue: [ ^ [ :character | #( 9 10 11 12 13 32 ) includes: character asInteger ] ].
	normalized = 'digit' ifTrue: [ ^ [ :character | character between: $0 and: $9 ] ].
	normalized = 'xdigit' ifTrue: [
		^ [ :character | (character between: $0 and: $9) or: [ (character between: $a and: $f) or: [ character between: $A and: $F ] ] ] ].
	^ [ :character | character asInteger < 128 and: [ (self unicodePosixPredicate: normalized caseless: caseless) value: character ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> predicateFor: property caseless: caseless [

	| normalized prefix value key ranges delimiter catalog |
	normalized := self normalize: property.
	(normalized beginsWith: '^') ifTrue: [
			ranges := self predicateFor: normalized allButFirst caseless: caseless.
			^ [ :character | (ranges value: character) not ] ].
	catalog := self data at: 'allowedProperties'.
	((normalized includes: $=) or: [ normalized includes: $: ])
		ifTrue: [
				delimiter := (normalized includes: $=)
					             ifTrue: [ $= ]
					             ifFalse: [ $: ].
				prefix := normalized copyUpTo: delimiter.
				value := normalized copyAfter: delimiter.
				(#( 'bc' 'bidiclass' ) includes: prefix) ifTrue: [ ^ self predicateFor: 'bidi' , value caseless: caseless ].
				(catalog includesKey: value) ifFalse: [ self unknownProperty: property ].
				(#( 'sc' 'script' ) includes: prefix) ifTrue: [ key := 'sc:' , (self alias: value family: 'sc') ].
				(#( 'scx' 'scriptextensions' ) includes: prefix) ifTrue: [ key := 'scx:' , (self alias: value family: 'sc') ].
				key ifNil: [ self unknownProperty: property ] ]
		ifFalse: [
				(catalog includesKey: normalized) ifFalse: [ self unknownProperty: property ].
				normalized = 'l&' ifTrue: [ normalized := 'lc' ].
				normalized = 'any' ifTrue: [ ^ [ :character | true ] ].
				normalized = 'ascii' ifTrue: [ ^ [ :character | character asInteger < 128 ] ].
				normalized = 'xuc' ifTrue: [
						^ [ :character |
							  character asInteger < 160
								  ifTrue: [ #( 36 64 96 ) includes: character asInteger ]
								  ifFalse: [ (character asInteger between: 16rD800 and: 16rDFFF) not ] ] ].
				normalized = 'xan' ifTrue: [
					^ [ :character | (self matches: 'gc:l' code: character asInteger) or: [ self matches: 'gc:n' code: character asInteger ] ] ].
				normalized = 'xwd' ifTrue: [ ^ [ :character | self isWord: character asInteger ] ].
				(#( 'xps' 'xsp' ) includes: normalized) ifTrue: [ ^ [ :character | self isSpace: character asInteger ] ].
				(normalized beginsWith: 'bidi') ifTrue: [
						value := normalized allButFirst: 4.
						(self rangesFor: 'bc:' , value) ifNotNil: [ key := 'bc:' , value ] ].
				key ifNil: [
						value := self alias: normalized family: 'gc'.
						(self rangesFor: 'gc:' , value) ifNotNil: [ key := 'gc:' , value ] ].
				key ifNil: [
						value := self alias: normalized family: 'sc'.
						(self rangesFor: 'scx:' , value) ifNotNil: [ key := 'scx:' , value ] ].
				key ifNil: [
						value := self alias: normalized family: 'bool'.
						(self rangesFor: 'bool:' , value) ifNotNil: [ key := 'bool:' , value ] ] ].
	(#( 'scx:zyyy' 'scx:zinh' 'scx:zzzz' ) includes: key) ifTrue: [ key := 'sc:' , (key copyAfter: $:) ].
	key ifNil: [ self unknownProperty: property ].
	(caseless and: [ #( 'gc:lu' 'gc:ll' 'gc:lt' ) includes: key ]) ifTrue: [ key := 'gc:lc' ].
	ranges := self rangesFor: key.
	ranges ifNil: [ self unknownProperty: property ].
	^ [ :character |
		  character asInteger > 16r10FFFF
			  ifTrue: [ self defaultProperty: key code: character asInteger ]
			  ifFalse: [ self includes: character asInteger in: ranges ] ]
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> rangesFor: key [

	^ (self data at: 'properties') at: key ifAbsent: [ nil ]
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readAliasesFrom: stream [

	| aliases |
	aliases := Dictionary new.
	(self readTextFrom: stream) do: [ :line | aliases at: (line copyUpTo: $=) put: (line copyAfter: $=) ].
	^ aliases
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readAllowedPropertiesFrom: stream [

	| allowed |
	allowed := Dictionary new.
	(self readTextFrom: stream) do: [ :property | allowed at: property put: true ].
	^ allowed
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readCodeTableFrom: stream digitValues: areDigitValues [
	"Codes in ascending order as gaps. A digit set stores the digit value; a fold stores the folded code."

	| table previous code |
	table := Dictionary new.
	previous := 0.
	(self readVarintFrom: stream) timesRepeat: [
			code := previous + (self readVarintFrom: stream).
			previous := code.
			table at: code asString put: (areDigitValues
					 ifTrue: [ code - (self readVarintFrom: stream) ]
					 ifFalse: [ self readVarintFrom: stream ]) ].
	^ table
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readEquivalentsFrom: stream [

	| equivalents previous code |
	equivalents := Dictionary new.
	previous := 0.
	(self readVarintFrom: stream) timesRepeat: [
			code := previous + (self readVarintFrom: stream).
			previous := code.
			equivalents at: code asString put: ((1 to: (self readVarintFrom: stream)) collect: [ :each | self readVarintFrom: stream ]) ].
	^ equivalents
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readPropertiesNamed: names from: stream in: bytes [
	"Note where each property starts and step over it, so only the properties a pattern uses are ever unpacked."

	| offsets start |
	offsets := Dictionary new.
	start := stream position.
	names do: [ :property |
			offsets at: property put: stream position - start.
			self skipRangesFrom: stream ].
	^ PCRE2PackedProperties new bytes: (bytes copyFrom: start + 1 to: stream position) offsets: offsets
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readRangesFrom: stream [
	"Inclusive pairs, each stored as the gap since the last end and its own length."

	| count ranges previous start |
	count := self readVarintFrom: stream.
	ranges := Array new: count * 2.
	previous := 0.
	1 to: count do: [ :index |
			start := previous + (self readVarintFrom: stream).
			previous := start + (self readVarintFrom: stream).
			ranges
				at: index * 2 - 1 put: start;
				at: index * 2 put: previous ].
	^ ranges
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readScriptMasksFrom: stream [
	"Triples of first code, last code and the mask of scripts the range may run with."

	| count masks previous start |
	count := self readVarintFrom: stream.
	masks := Array new: count * 3.
	previous := 0.
	1 to: count do: [ :index |
			start := previous + (self readVarintFrom: stream).
			previous := start + (self readVarintFrom: stream).
			masks
				at: index * 3 - 2 put: start;
				at: index * 3 - 1 put: previous;
				at: index * 3 put: (self readVarintFrom: stream) ].
	^ masks
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readTextFrom: stream [
	"A length-prefixed UTF-8 block of lines."

	| bytes |
	bytes := stream next: (self readVarintFrom: stream).
	^ (ZnCharacterEncoder utf8 decodeBytes: bytes) substrings: (String with: Character lf)
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> readVarintFrom: stream [
	"LEB128: seven bits at a time, low group first, high bit set while more follow."

	| value shift byte |
	value := 0.
	shift := 0.
	[
		byte := stream next.
		value := value + ((byte bitAnd: 16r7F) bitShift: shift).
		shift := shift + 7.
		byte >= 16r80 ] whileTrue.
	^ value
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> reset [

	Data := nil
]

{ #category : 'properties' }
PCRE2UnicodeData class >> same: first as: second unicode: unicode [

	unicode ifTrue: [ ^ (self fold: first asInteger) = (self fold: second asInteger) ].
	^ first = second or: [ (first asInteger < 128 and: [ second asInteger < 128 ]) and: [ first asLowercase = second asLowercase ] ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> same: first as: second unicode: unicode extraOptions: flags [

	| restricted variants |
	restricted := (flags bitAnd: PCRE2 extraCaselessRestrict) ~= 0.
	(unicode and: [ restricted not and: [ (flags bitAnd: PCRE2 extraTurkishCasing) ~= 0 ] ]) ifTrue: [
			variants := self turkishEquivalents: first asInteger.
			variants ifNotNil: [ ^ variants includes: second asInteger ] ].
	^ self
		  same: first
		  as: second
		  unicode: unicode
		  restricted: restricted
]

{ #category : 'properties' }
PCRE2UnicodeData class >> same: first as: second unicode: unicode restricted: restricted [

	(restricted and: [ first asInteger < 128 ~= (second asInteger < 128) ]) ifTrue: [ ^ false ].
	^ self same: first as: second unicode: unicode
]

{ #category : 'properties' }
PCRE2UnicodeData class >> scriptMaskFor: code [

	| ranges low high middle |
	ranges := self data at: 'scriptMasks'.
	low := 1.
	high := ranges size // 3.
	[ low <= high ] whileTrue: [
			middle := low + high // 2.
			code < (ranges at: middle * 3 - 2)
				ifTrue: [ high := middle - 1 ]
				ifFalse: [
						code > (ranges at: middle * 3 - 1)
							ifTrue: [ low := middle + 1 ]
							ifFalse: [ ^ ranges at: middle * 3 ] ] ].
	^ 0
]

{ #category : 'decoding' }
PCRE2UnicodeData class >> skipRangesFrom: stream [
	"Step over one property without building its ranges."

	(self readVarintFrom: stream) * 2 timesRepeat: [ self readVarintFrom: stream ]
]

{ #category : 'properties' }
PCRE2UnicodeData class >> turkishEquivalents: code [

	(#( 73 305 ) includes: code) ifTrue: [ ^ #( 73 305 ) ].
	(#( 105 304 ) includes: code) ifTrue: [ ^ #( 105 304 ) ].
	^ nil
]

{ #category : 'properties' }
PCRE2UnicodeData class >> unicodePosixPredicate: property caseless: caseless [

	| key |
	property = 'ascii' ifTrue: [ ^ [ :character | character asInteger < 128 ] ].
	property = 'alnum' ifTrue: [ ^ self predicateFor: 'Xan' caseless: caseless ].
	property = 'word' ifTrue: [ ^ [ :character | self isWord: character asInteger ] ].
	property = 'space' ifTrue: [ ^ [ :character | self isSpace: character asInteger ] ].
	property = 'blank' ifTrue: [ ^ [ :character | character asInteger = 9 or: [ self matches: 'gc:zs' code: character asInteger ] ] ].
	property = 'graph' ifTrue: [ ^ [ :character | self isGraph: character asInteger ] ].
	property = 'print' ifTrue: [ ^ [ :character | self isPrint: character asInteger ] ].
	property = 'punct' ifTrue: [
			^ [ :character |
				  (self matches: 'gc:p' code: character asInteger) or: [
					  character asInteger < 128 and: [ self matches: 'gc:s' code: character asInteger ] ] ] ].
	property = 'xdigit' ifTrue: [
			^ [ :character |
				  | code |
				  code := character asInteger.
				  (code between: 48 and: 57) or: [
						  (code between: 65 and: 70) or: [
								  (code between: 97 and: 102) or: [
									  (code between: 16rFF10 and: 16rFF19) or: [
										  (code between: 16rFF21 and: 16rFF26) or: [ code between: 16rFF41 and: 16rFF46 ] ] ] ] ] ] ].
	key := (Dictionary newFrom: {
			        ('alpha' -> 'L').
			        ('lower' -> 'Ll').
			        ('upper' -> 'Lu').
			        ('digit' -> 'Nd').
			        ('cntrl' -> 'Cc') }) at: property ifAbsent: [ PCRE2UnsupportedFeature signal: 'POSIX class ' , property ].
	^ self predicateFor: key caseless: caseless
]

{ #category : 'properties' }
PCRE2UnicodeData class >> unknownProperty: property [

	PCRE2UnsupportedFeature signal: 'Unknown PCRE2 Unicode property ' , property
]

{ #category : 'accessing' }
PCRE2UnicodeData class >> version [

	^ self data at: 'version'
]
